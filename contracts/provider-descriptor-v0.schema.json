{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/05wuyanzi/tannang/contracts/provider-descriptor-v0.schema.json",
  "title": "Tannang Provider Descriptor v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "class", "capabilities", "requirements", "side_effects", "quality"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "class": {
      "enum": ["WINDOWS_INBOX", "FIRST_PARTY_NATIVE", "EXTERNAL_BACKEND", "SYNTHETIC_TEST"]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z0-9_]+$" }
    },
    "requirements": { "type": "object" },
    "side_effects": { "type": "array", "items": { "type": "string" } },
    "quality": { "type": "object" }
  }
}
